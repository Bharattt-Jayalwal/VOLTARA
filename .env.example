# Supabase project values. Leave blank to run the labeled, local-only demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys can also be used by older Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public OpenStreetMap tile endpoint (attribution is shown in the map UI).
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Set to the actual canonical origin after choosing a domain; do not guess one.
NEXT_PUBLIC_SITE_URL=

# Server-only credentials for the persisted support endpoint. Never prefix these
# with NEXT_PUBLIC_ and never expose them in client code or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
CONTACT_HASH_SECRET=

# Optional Resend delivery. Database persistence works without email delivery,
# but the form will clearly report that email has not been configured.
RESEND_API_KEY=
SUPPORT_EMAIL=
RESEND_FROM_EMAIL=
